# Telegram
BOT_TOKEN=
BOT_USERNAME=SubFlowBot
WEBAPP_URL=https://your-domain.example

# API
PORT=3000
# Секрет сессии после проверки initData. Задайте длинную случайную строку.
JWT_SECRET=change-me
# Общий секрет между API и ботом для внутренних вызовов.
INTERNAL_SECRET=change-me-too
DATABASE_URL=postgresql://subflow:subflow@localhost:5432/subflow
REDIS_URL=redis://localhost:6379

# TON
# Дружественный адрес мастер-контракта платформы (SubscriptionRouter).
ROUTER_ADDRESS=
# Комиссия платформы в базисных пунктах. 150 = 1.5%
PLATFORM_FEE_BPS=150
TONAPI_KEY=
TONAPI_ENDPOINT=https://tonapi.io

# Mini App (префикс VITE_ обязателен — эти значения попадают в браузер)
VITE_API_URL=http://localhost:3000
VITE_BOT_USERNAME=SubFlowBot
VITE_ROUTER_ADDRESS=
VITE_TONCONNECT_MANIFEST_URL=
