generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  telegramId      BigInt         @unique
  username        String?
  firstName       String
  lastName        String?
  language        String         @default("en")
  displayCurrency String         @default("USD")
  notifyDays      Int[]          @default([7, 3, 1])
  walletAddress   String?
  plusUntil       DateTime?
  createdAt       DateTime       @default(now())
  subscriptions   Subscription[]
  plans           Plan[]
  memberships     Membership[]
  merchantKey     MerchantKey?
  splits          SplitPool[]
}

model Subscription {
  id            String     @id
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  emoji         String
  color         String
  amount        Decimal    @db.Decimal(18, 6)
  currency      String
  period        String
  customDays    Int?
  nextChargeAt  DateTime
  paymentMethod String
  category      String
  status        String     @default("active")
  note          String?
  isTrial       Boolean    @default(false)
  trialEndsAt   DateTime?
  templateId    String?
  chainNonce    BigInt     @unique
  createdAt     DateTime   @default(now())
  reminders     Reminder[]
  splits        SplitPool[]

  @@index([userId, status])
  @@index([nextChargeAt])
}

model Reminder {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  daysBefore     Int
  cycleKey       String
  sentAt         DateTime     @default(now())

  @@unique([subscriptionId, daysBefore, cycleKey])
}

model Plan {
  id          String       @id
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  amount      Decimal      @db.Decimal(18, 6)
  currency    String
  period      String
  chatId      String?
  chainNonce  BigInt       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]

  @@index([ownerId])
}

model Membership {
  id         String    @id @default(cuid())
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String
  expiresAt  DateTime?
  inviteLink String?
  kickedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, expiresAt])
  @@index([userId])
}

model Payment {
  id          String    @id @default(cuid())
  txHash      String?   @unique
  messageHash String?   @unique
  boc         String?
  provider    String
  userId      String?
  planId      String?
  comment     String?
  chainNonce  BigInt?
  amount      Decimal?  @db.Decimal(18, 6)
  currency    String?
  status      String
  attempts    Int       @default(0)
  nextCheckAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, nextCheckAt])
}

model SplitPool {
  id                String         @id
  subscriptionId    String
  subscription      Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizerAddress  String?
  title             String
  amount            Decimal        @db.Decimal(18, 6)
  currency          String
  createdAt         DateTime       @default(now())
  members           SplitMember[]

  @@index([ownerId])
}

model SplitMember {
  id     String    @id
  poolId String
  pool   SplitPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  name   String
  share  Decimal   @db.Decimal(18, 6)
  status String    @default("pending")
  isSelf Boolean   @default(false)

  @@index([poolId])
}

model MerchantKey {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey        String   @unique
  webhookUrl    String?
  webhookSecret String
  createdAt     DateTime @default(now())
}
